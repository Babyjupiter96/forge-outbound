# Supabase (Settings -> API in your Supabase project)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google Cloud — Places API (New) must be enabled on the project.
# Requires a billing account attached even though usage stays in the
# free monthly allowance (5,000 Text Search calls/mo) at MVP volume.
GOOGLE_PLACES_API_KEY=""

# Apollo.io — free tier account. Used for decision-maker + email lookup.
APOLLO_API_KEY=""

# OpenAI — reuse the same key/account as forge-platform if you want,
# or a separate one. gpt-4o-mini is what the pipeline is built against.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Resend — sending. Must verify a domain (see README "Domain setup")
# before this can send anything.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""

# The dedicated outbound domain's sending identity.
OUTBOUND_FROM_EMAIL="hello@outreach.example.com"
OUTBOUND_FROM_NAME="Jack from Forge Digital AI"
OUTBOUND_REPLY_TO="hello@outreach.example.com"

# IMAP credentials for the SAME inbox as OUTBOUND_REPLY_TO, used once/day
# to detect replies/bounces/unsubscribe requests. See README for the
# recommended free provider (Zoho Mail) and setup.
IMAP_HOST=""
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASSWORD=""

# Shared secret the daily Vercel Cron request must present, so the
# pipeline endpoint can't be triggered by anyone who finds the URL.
CRON_SECRET=""

# Which cities/keywords to search this run — see README for how this
# list grows over time instead of re-searching the same ground forever.
TARGET_CITIES="Phoenix,Scottsdale,Mesa"
TARGET_KEYWORDS="HVAC contractor,heating and cooling,AC repair,furnace repair"

# Daily send cap — the actual lever for the 10-25 -> 250/day scaling
# plan in the README. Start low.
DAILY_SEND_CAP="15"
